@model IEnumerable<PASSIFY.Models.Purchase>

@{
    ViewData["Title"] = "Purchases";
    var purchase_table = new TableViewModel<Purchase>
    {
        Items = Model,
        Id = model => model.PurchaseId,
        ShowActions = true,
        Columns =
        [
            new TableColumn<Purchase> { Header = "NoOfTickets", Value = model => model.NoOfTickets },
            new TableColumn<Purchase> { Header = "CustomerEmail", Value = model => model.CustomerEmail },
            new TableColumn<Purchase> { Header = "CreditCardExp", Value = model => model.CreditCardExp },
            new TableColumn<Purchase> { Header = "CreditCardCvv", Value = model => model.CreditCardCvv },
            new TableColumn<Purchase> { Header = "Activity", Value = model => model.Activity.Title },
        ]

    };
}


<partial name="_Header" model="@ViewBag.Title" />

@await Html.PartialAsync("_Table", purchase_table)