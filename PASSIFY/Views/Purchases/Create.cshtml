@model PASSIFY.Models.Purchase

@{
    ViewData["Title"] = "Create";
}

<div class="px-6 py-8">
    <h1 class="text-3xl font-bold text-gray-900">Create Purchase</h1>
    <p class="text-gray-500 mt-2">Fill out the form below to create a new purchase.</p>
</div>

<div class="px-6 pb-8">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 max-w-2xl">
        <form asp-action="Create" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-4"></div>
            <div>
                <label asp-for="NoOfTickets" class="block text-sm font-medium text-gray-700"></label>
                <input asp-for="NoOfTickets" class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" />
                <span asp-validation-for="NoOfTickets" class="text-red-500 text-xs"></span>
            </div>
            <div>
                <label asp-for="CustomerEmail" class="block text-sm font-medium text-gray-700"></label>
                <input asp-for="CustomerEmail" class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" />
                <span asp-validation-for="CustomerEmail" class="text-red-500 text-xs"></span>
            </div>
            <div>
                <label asp-for="CreditCardExp" class="block text-sm font-medium text-gray-700"></label>
                <input asp-for="CreditCardExp" class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" />
                <span asp-validation-for="CreditCardExp" class="text-red-500 text-xs"></span>
            </div>
            <div>
                <label asp-for="CreditCardCvv" class="block text-sm font-medium text-gray-700"></label>
                <input asp-for="CreditCardCvv" class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" />
                <span asp-validation-for="CreditCardCvv" class="text-red-500 text-xs"></span>
            </div>
            <div>
                <label asp-for="ActivityId" class="block text-sm font-medium text-gray-700"></label>
                <select asp-for="ActivityId" class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" asp-items="ViewBag.ActivityId"></select>
            </div>
            <div class="pt-4">
                <input type="submit" value="Create" class="w-full bg-blue-600 text-white font-bold py-3 px-6 rounded-xl hover:bg-blue-700 transition duration-300 cursor-pointer" />
            </div>
        </form>
    </div>
</div>

<div class="px-6 pb-8">
    <a asp-action="Index" class="text-gray-500 hover:text-gray-900 transition">← Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

