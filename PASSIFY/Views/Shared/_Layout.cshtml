@using PASSIFY.Controllers
@{
    var sidebarItems = new List<NavItem>
    {
        new()
        {
            Controller = "Home",
            Action = "Index",
            Text = "Home",
            Icon = "organizer"
        },  
        new() {
            Controller = "Organizers",
            Action = "Index",
            Text = "Organizers",
            Icon = "organizer"
        },
        new()
        {
            Controller = "Categories",
            Action = "Index",
            Text = "Categories",
            Icon = "event"
        }
    }; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - PASSIFY</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true"/>
</head>
<body>



    <div class="flex flex-col grow min-h-screen bg-white'">
          
            <!--Start Navbar-->
        <nav class="sticky top-0 bg-white  shadow-sm z-10">
            <div class="container mx-auto px-5">
                <div id="for-end" class="flex flex-row-reverse sm:flex-row items-center">
                    <div>
                        @*Logo*@
                        <a class="py-2 px-3 text-gray-800" asp-area="" asp-controller="Home"
                           asp-action="Index">PASSIFY</a>
                    </div>
                    @*Login/Logout*@
                    <div class="flex ml-auto items-center">
                        @if (User.Identity != null)
                        {
                            @if (User.Identity.IsAuthenticated)
                            {
                                <div>
                                    <p class="p-3">Hello, <span class="text-blue-600">@User.Identity.Name</span></p>
                                </div>
                                <div >
                                    <button class="p-3 text-gray-800 hover:bg-amber-500 transition-colors duration-300" asp-action="Logout"
                                            asp-controller="Account">Logout</button>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="nav-item">
                                <a class="block py-2 px-3 text-gray-800" asp-action="Login"
                                   asp-controller="Account">Login</a></div>
                        }
                    </div>
                </div>
                
            </div>
        </nav>
        <!--End Navbar-->

        <div class="flex flex-row overflow-hidden">

            @*side bar nav *@
            <aside class="fixed flex flex-col shrink-0 test-sidebar min-h-screen bg-gray-100 shadow-sm">

                <!--Sidebar-->
                @*List of Nav links and their logos*@
                <ul class="flex flex-col mb-auto text-center">
                    
                @foreach (var item in sidebarItems)
                {
                    <li class="hover:bg-gray-300">
                        <a asp-controller="@item.Controller" asp-action="@item.Action"
                           class="text-gray-800 no-underline p-3 flex flex-col items-center" title=""
                           data-bs-toggle="tooltip"
                           data-bs-placement="right" data-bs-original-title="Dashboard">
                            <svg class="mb-2 w-5 h-5">
                                <use href="@item.Icon"/>
                            </svg>
                            <span>@item.Text</span>
                        </a>
                    </li>
                }
                    
                    @*Copy item n if extra needed*@
                </ul>
            </aside>
            <!--End Sidebar-->

            <div class="container mx-auto mt-1 px-4">

                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>

    </div>




<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>