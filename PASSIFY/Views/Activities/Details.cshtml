@using Microsoft.IdentityModel.Tokens
@model PASSIFY.Models.Activity

@{
    ViewData["Title"] = "Details";
    //Used to ignore certain fields from displaying in the details view.
    var ignore = new List<string> { "ActivityId", "FormFile", "ImageName", "OrganizerId", "CategoryId" };
    var buttonStyle = "px-5 py-3 rounded-lg transition duration-300 ease-in-out transform hover:scale-105 cursor-pointer";
}

<div class="mx-auto py-10 max-w-5xl">

    <div class="flex flex-row gap-4 mb-6">

        <a asp-action="Index" asp-controller="Home" class="@buttonStyle bg-gray-100 hover:bg-gray-200 border border-gray-200">
            Back
        </a>
        <a asp-route-id="@Model.ActivityId" asp-action="Edit" class="@buttonStyle bg-blue-100 hover:bg-blue-200 text-blue-800 border border-blue-200">
            Edit
        </a>
    </div>
    <!-- Image -->
    <div class="h-96 overflow-hidden rounded-2xl shadow-xl">
        <img
            src="@Model.ImageName"
            class="w-full h-full object-cover"
            alt="@Model.Title">
    </div>

    <!-- Floating content -->
    <div class="-mt-20 mx-6 bg-white rounded-2xl shadow-2xl p-10 relative z-10 border border-gray-100">
        <div class="flex w-full items-start justify-between">
            <div class="flex-1">
                <h1 class="text-5xl font-extrabold text-gray-900 tracking-tight">
                    @Model.Title
                </h1>

                <p class="text-lg text-gray-600 mt-3 font-medium">
                    Hosted by <span class="text-blue-600">@Model.Organizer.Name</span>
                </p>

                <div class="flex flex-col gap-2 mt-6 text-gray-700">
                    <div class="flex items-center gap-3">
                        <svg class="w-6 h-6 text-blue-500">
                            <use href="@Helpers.SvgPath("calendar")"/>
                        </svg>
                        <p class="text-base">@Model.EventStart.ToLongDateString() - @Model.EventEnd.ToLongDateString()</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <svg class="w-6 h-6 text-blue-500">
                            <use href="@Helpers.SvgPath("clock")"/>
                        </svg>
                        <p class="text-base">@Model.EventStart.ToLongTimeString() - @Model.EventEnd.ToLongTimeString()</p>
                    </div>
                </div>
            </div>
            
        </div>

        <hr class="my-8 border-gray-200">

        <h2 class="text-xl font-semibold text-gray-900 mb-4">About this activity</h2>
        <p class="text-gray-700 leading-relaxed text-lg">
            @Model.Description
        </p>

        <div class="mt-10 flex gap-4">
            <button class="px-8 py-3 bg-blue-600 text-white rounded-xl font-semibold hover:bg-blue-700 transition shadow-md">
                Register Now
            </button>

            <button class="px-8 py-3 border border-gray-300 text-gray-700 rounded-xl font-semibold hover:bg-gray-50 transition">
                Share
            </button>
        </div>

    </div>

</div>
