@model PASSIFY.Models.Activity

@{
    ViewData["Title"] = "Create";
}


<div class="px-6 py-8">
    <h1 class="text-3xl font-bold text-gray-900">Create new activity</h1>
    <p class="text-gray-500 mt-2">Fill out the form below to create a new activity.</p>
</div>

<div class="px-6 pb-8">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <form asp-action="Create" enctype="multipart/form-data" class="space-y-4">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-4"></div>

                <div>
                    <label asp-for="Title" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="Title" class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"/>
                    <span asp-validation-for="Title" class="text-red-500 text-xs"></span>
                </div>
                <div>
                    <label asp-for="Description" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="Description" class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"/>
                    <span asp-validation-for="Description" class="text-red-500 text-xs"></span>
                </div>
                <div>
                    <label asp-for="EventStart" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="EventStart" class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"/>
                    <span asp-validation-for="EventStart" class="text-red-500 text-xs"></span>
                </div>
                <div>
                    <label asp-for="EventEnd" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="EventEnd" class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"/>
                    <span asp-validation-for="EventEnd" class="text-red-500 text-xs"></span>
                </div>
                
                <div>
                    <label asp-for="FormFile" class="block text-sm font-medium text-gray-700"></label>
                    <input type="file" asp-for="FormFile" class="mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100"/>
                    <span asp-validation-for="FormFile" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label asp-for="OrganizerId" class="block text-sm font-medium text-gray-700"></label>
                    <select asp-for="OrganizerId" class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" asp-items="ViewBag.OrganizerId"></select>
                </div>
                <div>
                    <label asp-for="CategoryId" class="block text-sm font-medium text-gray-700"></label>
                    <select asp-for="CategoryId" class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" asp-items="ViewBag.CategoryId"></select>
                </div>

                <div class="pt-4">
                    <input type="submit" value="Create" class="w-full bg-blue-600 text-white font-bold py-3 px-6 rounded-xl hover:bg-blue-700 transition duration-300 cursor-pointer"/>
                </div>
            </form>

            <div class="border-l border-gray-100 pl-8">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Activity Image Preview</h3>
                <div class="bg-gray-50 rounded-xl border border-dashed border-gray-300 h-64 flex items-center justify-center">
                    <img src="@Url.Content("~/assets/photos/" + Model?.ImageName)" alt="@Model?.Title"
                         class="max-h-full object-contain rounded-lg">
                </div>
            </div>
        </div>
    </div>
</div>

<div class="px-6 pb-8">
    <a asp-controller="Home" asp-action="Index" class="text-gray-500 hover:text-gray-900 transition">← Back to List</a>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
