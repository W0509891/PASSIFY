@model PASSIFY.Models.Organizer

@{
    ViewData["Title"] = "Edit";
}

<h4>Edit Organizer</h4>

<div class="flex flex-row">
    <div class="">
        <form asp-action="Edit" class="flex flex-col">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="OrganizerId" />
            <div class="flex flex-col mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="flex gap-1 self-end">
                <a asp-action="Index"
                    class="bg-gray-400 font-bold py-2 px-4 rounded hover:bg-gray-700 transition duration-300 cursor-pointer"
                >Back to List
                    </a>
                <button class="bg-blue-600 text-white font-bold py-2 px-4 rounded hover:bg-blue-700 transition duration-300 cursor-pointer" >
                    Save
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
