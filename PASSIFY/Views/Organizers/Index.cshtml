@model IEnumerable<PASSIFY.Models.Organizer>

@{
    ViewData["Title"] = "Index";
}

<div class="flex justify-between items-center">
    <h1>Organizers Database</h1>
    <div>
        <a class="inline-block bg-blue-600 text-white font-bold py-2 px-4 rounded hover:bg-blue-700 transition duration-300" asp-action="Create">Create New</a>
    </div>
</div>

@{
    var organizersTable = new TableViewModel<Organizer>
    {
        Items = Model ?? [],
        Id = item => item.OrganizerId,
        ShowActions = true,
        Columns =
        [
            new TableColumn<Organizer> { Header = "Name", Value = item => item.Name ?? "" },
            new TableColumn<Organizer> { Header = "Events", Value = item => item.Activities?.Count ?? 0 },
        ]
    };
}

<div>
    @await Html.PartialAsync("_Table", organizersTable)
</div>

