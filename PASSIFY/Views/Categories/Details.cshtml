@model PASSIFY.Models.Category

@{
    ViewData["Title"] = "Details";
    var data = new Dictionary<string, dynamic>
    {
        {"Title", @Model.Title},
        {"Id", @Model.CategoryId},
        {"Type", "Category"}
    };

    // Console.WriteLine(data.GetValueOrDefault());
}

@await Html.PartialAsync("_HeaderWithNav", @data)

@{
    var table = new TableViewModel<Activity>
    {
        Items = Model.Activities ?? [],
        Id = x => x.ActivityId,
        ShowActions = false,
        Columns =
        [
            new TableColumn<Activity> { Header = "Image", Value = x => x.ImageName ?? "" },
            new TableColumn<Activity> { Header = "Title", Value = x => x.Title }, 
            new TableColumn<Activity> { Header = "Purchases", Value = x => x.Purchases.Count },
            new TableColumn<Activity> { Header = "Start Date", Value = x => x.EventStart },
            new TableColumn<Activity> { Header = "End Date", Value = x => x.EventEnd }
        ]
    };
}

<section class="sticky top-0 bg-white p-4 shadow-sm z-20 border-b border-gray-100 flex justify-between items-center" id="action-section">
    <div class="flex-1">
        <input type="text" class="px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none w-64"
               oninput="searchTable(this.value)"
               placeholder="Search activities..."/>
    </div>
</section>

<div class="px-6 py-4">
    @await Html.PartialAsync("_Table", table)
</div>
