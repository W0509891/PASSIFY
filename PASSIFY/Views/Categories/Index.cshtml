@model IEnumerable<PASSIFY.Models.Category>

@{
    ViewData["Title"] = "Categories";
}


<partial name="_Header" model="@ViewBag.Title" />

@{
    var categoryTable = new TableViewModel<Category>
    {
        Items = Model ?? [],
        Id = item => item.CategoryId,
        ShowActions = true,
        Columns =
        [
            new TableColumn<Category> { Header = "Title", Value = item => item.Title ?? "" },
            new TableColumn<Category> { Header = "Events", Value = item => item.Activities?.Count},
        ]
    };
}

<div>
    @await Html.PartialAsync("_Table", categoryTable)
</div>

