@* HOMEPAGE INDEX *@
@model IEnumerable<PASSIFY.Models.Activity>

@{
    ViewData["Title"] = "Home Page";
    var activities = Model ?? new List<Activity>();
}

<div class="px-6 py-8">
    <h1 class="text-3xl font-bold text-gray-900">Welcome, <span class="text-blue-600">@User.Identity.Name</span></h1>
    <p class="text-gray-500 mt-2">Manage your events, categories, and organizers.</p>
</div>

<section class="sticky top-0 bg-white p-4 shadow-sm z-20 border-b border-gray-100 flex justify-between items-center" id="add-section">
    <div class="flex-1">
        <input type="text" class="px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none w-64" 
               oninput="searchTable(this.value)"
               placeholder="Search activities..."/>
    </div>
    <div class="flex items-center gap-4">
        @* Add event *@
        <a asp-controller="Activities" asp-action="Create"
           class="text-gray-600 hover:text-blue-600 flex flex-col items-center p-2 rounded-lg hover:bg-blue-50 transition">
            <svg class="w-6 h-6">
                <use href="@Helpers.SvgPath("event")"/>
            </svg>
            <span class="text-xs font-medium">Add event</span>
        </a>
        @* Add Category *@
        <a asp-controller="Categories" asp-action="Create"
           class="text-gray-600 hover:text-blue-600 flex flex-col items-center p-2 rounded-lg hover:bg-blue-50 transition">
            <svg class="w-6 h-6">
                <use href="@Helpers.SvgPath("cat_tag")"/>
            </svg>
            <span class="text-xs font-medium">Add category</span>
        </a>
        <a asp-controller="Organizers" asp-action="Create"
           class="text-gray-600 hover:text-blue-600 flex flex-col items-center p-2 rounded-lg hover:bg-blue-50 transition">
            <svg class="w-6 h-6">
                <use href="@Helpers.SvgPath("organizer")"/>
            </svg>
            <span class="text-xs font-medium">Add organizer</span>
        </a>
    </div>
</section>

@{
    var eventsTable = new TableViewModel<Activity>
    {
        Items = Model ?? [],
        Id = x => x.ActivityId,
        Columns =
        [
            new TableColumn<Activity> { Header = "Image", Value = x => x.ImageName ?? "" },
            new TableColumn<Activity> { Header = "Title", Value = x => x.Title }, 
            new TableColumn<Activity> { Header = "Description", Value = x => x.Description },
            new TableColumn<Activity> { Header = "Start", Value = x => x.EventStart },
            new TableColumn<Activity> { Header = "End", Value = x => x.EventEnd },
            new TableColumn<Activity> { Header = "Created", Value = x => x.Created},
            new TableColumn<Activity> { Header = "Organizer", Value = x => x.Organizer.Name }
        ]
    };
}

@*TODO: convert table to div layout*@
<section class="p-2">
    @await Html.PartialAsync("_Table", eventsTable)
</section>